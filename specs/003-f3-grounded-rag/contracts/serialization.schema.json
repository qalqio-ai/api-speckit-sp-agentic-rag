          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "retrieval_deadline": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "result",
        "scope_snapshot",
        "retrieval_searches",
        "retrieval_deadline"
      ],
      "additionalProperties": false
    }
  }
}
